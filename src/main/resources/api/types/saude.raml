#%RAML 1.0 DataType
type: object
description: Resultado do healthcheck da Pedidos API.
properties:
  status:
    type: string
    enum: [UP, DEGRADED, DOWN]
  api: string
  versao: string
  porta: integer
  verificadoEm: datetime
  detalhes:
    type: object
    description: Checagens especificas desta API.
    properties:
      storePedidos:
        type: string
        enum: [UP, DOWN]
      pedidosCarregados: integer
      itensOrfaos: integer
      pedidosSemItem: integer
      dependenciaClientesApi:
        type: string
        enum: [UP, DOWN, NAO_VERIFICADO]
