#%RAML 1.0 DataType
type: object
description: Pedido com seus itens.
properties:
  id:
    type: string
    example: PED-5001
  clienteId:
    type: string
    example: CLI-1001
  situacao:
    type: string
    enum: [RASCUNHO, CONFIRMADO, CANCELADO]
  valorTotal:
    type: number
    minimum: 0
  itens:
    type: array
    items: !include item-pedido.raml
  criadoEm: datetime
